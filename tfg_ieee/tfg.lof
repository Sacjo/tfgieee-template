\contentsline {figure}{\numberline {6.1}{\ignorespaces Encabezado del formulario de encuestas. [Figura propia]}}{111}{figure.6.1}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Resultados de la primera pregunta de la encuesta: “El sistema es fácil de usar y navegar”. [Figura propia]}}{112}{figure.6.2}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Resultados de la segunda pregunta de la encuesta: “Las funciones principales se entienden sin necesidad de asistencia o capacitación”. [Figura propia]}}{112}{figure.6.3}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Resultados de la tercera pregunta de la encuesta: “El tiempo de respuesta del sistema es adecuado durante su uso”. [Figura propia]}}{113}{figure.6.4}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Resultados de la cuarta pregunta de la encuesta: “Los mensajes o indicaciones del sistema son claros y comprensibles”. [Figura propia]}}{113}{figure.6.5}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Resultados de la quinta pregunta de la encuesta: “Puedo realizar las tareas necesarias (registro, asistencia, reportes) sin dificultad”. [Figura propia]}}{114}{figure.6.6}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Resultados de la sexta pregunta de la encuesta: “La interfaz del sistema tiene una apariencia ordenada y agradable”. [Figura propia]}}{114}{figure.6.7}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Resultados de la séptima pregunta de la encuesta: “Me siento seguro al utilizar el sistema para registrar información”. [Figura propia]}}{115}{figure.6.8}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Resultados de la octava pregunta de la encuesta: “Considero que el sistema mejora la rapidez y eficiencia del control de asistencia”. [Figura propia]}}{115}{figure.6.9}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces Resultados de la novena pregunta de la encuesta: “No experimenté errores o confusiones significativas al interactuar con las opciones del sistema”. [Figura propia]}}{116}{figure.6.10}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Resultados de la décima pregunta de la encuesta: “En general, estoy satisfecho con la experiencia de uso que ofrece el sistema”. [Figura propia]}}{116}{figure.6.11}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.12}{\ignorespaces Importaciones principales y definición de rutas base del módulo de entrenamiento \texttt {train\_faces.py}. Se cargan dependencias para detección y representación facial y se establecen las carpetas de trabajo del pipeline. [Figura propia]}}{118}{figure.6.12}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Función \texttt {recortar\_y\_guardar()} del módulo \texttt {train\_faces.py}. Detecta el rostro con YOLOv8, recorta la región correspondiente y guarda una versión normalizada (160$\times $160) para su uso en la generación de embeddings. [Figura propia]}}{119}{figure.6.13}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Fragmento del código de la función \texttt {generar\_embeddings()} del módulo \texttt {train\_faces.py}, donde se generan las representaciones vectoriales de los rostros utilizando el modelo \texttt {ArcFace} de DeepFace. [Figura propia]}}{120}{figure.6.14}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Fragmento del código que calcula el centroide facial y actualiza el índice global \texttt {centroids.json} con los nuevos embeddings generados. [Figura propia]}}{121}{figure.6.15}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Importaciones y configuración inicial del módulo \texttt {face\_recognizer.py}, donde se establecen las rutas a los embeddings y centroides utilizados en la fase de reconocimiento. [Figura propia]}}{122}{figure.6.16}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Función \texttt {load\_centroids()} del módulo \texttt {face\_recognizer.py}, responsable de cargar y normalizar los centroides almacenados para su uso en el proceso de reconocimiento facial. [Figura propia]}}{123}{figure.6.17}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Función \texttt {recognize\_face()} del módulo \texttt {face\_recognizer.py}, encargada de generar el embedding del rostro y compararlo con los centroides almacenados mediante la distancia coseno. [Figura propia]}}{124}{figure.6.18}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Función \texttt {recognize\_faces\_from\_crops()} del módulo \texttt {face\_recognizer.py}, utilizada para procesar múltiples rostros detectados en una misma imagen y devolver sus resultados de identificación. [Figura propia]}}{125}{figure.6.19}%
