\contentsline {figure}{\numberline {5.1}{\ignorespaces Fragmento de código utilizado para configurar el umbral de reconocimiento.[Figura Propia]}}{78}{figure.5.1}%
\contentsline {figure}{\numberline {5.2}{\ignorespaces Muy estricto, reconoce solo rostros casi idénticos.[Figura Propia]}}{78}{figure.5.2}%
\contentsline {figure}{\numberline {5.3}{\ignorespaces Fragmento de código utilizado para configurar el umbral de reconocimiento.[Figura Propia]}}{79}{figure.5.3}%
\contentsline {figure}{\numberline {5.4}{\ignorespaces Estricto, buena precisión, pero sensible a luz o expresión.[Figura Propia]}}{79}{figure.5.4}%
\contentsline {figure}{\numberline {5.5}{\ignorespaces Fragmento de código utilizado para configurar el umbral de reconocimiento.[Figura Propia]}}{80}{figure.5.5}%
\contentsline {figure}{\numberline {5.6}{\ignorespaces Equilibrado, balance entre precisión y tolerancia.[Figura Propia]}}{80}{figure.5.6}%
\contentsline {figure}{\numberline {5.7}{\ignorespaces Fragmento de código utilizado para configurar el umbral de reconocimiento.[Figura Propia]}}{81}{figure.5.7}%
\contentsline {figure}{\numberline {5.8}{\ignorespaces Moderadamente flexible, admite pequeñas variaciones.[Figura Propia]}}{81}{figure.5.8}%
\contentsline {figure}{\numberline {5.9}{\ignorespaces Fragmento de código utilizado para configurar el umbral de reconocimiento.[Figura Propia]}}{82}{figure.5.9}%
\contentsline {figure}{\numberline {5.10}{\ignorespaces Puede aceptar coincidencias con diferencias notables.[Figura Propia]}}{82}{figure.5.10}%
\contentsline {figure}{\numberline {5.11}{\ignorespaces Prueba inicial del sistema bajo condiciones de iluminación máxima, con detección de personas registradas y no registradas. [Figura Propia]}}{83}{figure.5.11}%
\contentsline {figure}{\numberline {5.12}{\ignorespaces Segunda prueba con iluminación uniforme, evidenciando estabilidad en las detecciones. [Figura Propia]}}{84}{figure.5.12}%
\contentsline {figure}{\numberline {5.13}{\ignorespaces Prueba con variaciones leves de postura y uso de accesorios, manteniendo altos niveles de reconocimiento. [Figura Propia]}}{85}{figure.5.13}%
\contentsline {figure}{\numberline {5.14}{\ignorespaces Prueba a mayor distancia, con leve disminución en la similitud pero reconocimiento correcto de los usuarios registrados. [Figura Propia]}}{86}{figure.5.14}%
\contentsline {figure}{\numberline {5.15}{\ignorespaces Prueba con iluminación reducida, mostrando una disminución natural en la precisión de reconocimiento. [Figura Propia]}}{87}{figure.5.15}%
\contentsline {figure}{\numberline {5.16}{\ignorespaces Prueba con iluminación mínima, donde el sistema no logró reconocer a los participantes. [Figura Propia]}}{88}{figure.5.16}%
\contentsline {figure}{\numberline {5.17}{\ignorespaces Prueba con condiciones normales de iluminación y cambio de posición de los participantes registrados. [Figura Propia]}}{89}{figure.5.17}%
\contentsline {figure}{\numberline {5.18}{\ignorespaces Prueba con la cámara a una altura de aproximadamente 2,30 metros, mostrando un reconocimiento estable. [Figura Propia]}}{90}{figure.5.18}%
\contentsline {figure}{\numberline {5.19}{\ignorespaces Prueba con ocho participantes en el encuadre, reconociendo correctamente a los seis usuarios registrados. [Figura Propia]}}{91}{figure.5.19}%
\contentsline {figure}{\numberline {5.20}{\ignorespaces Prueba grupal con iluminación mínima, sin reconocimiento exitoso de los usuarios registrados. [Figura Propia]}}{92}{figure.5.20}%
\contentsline {figure}{\numberline {5.21}{\ignorespaces Prueba con la cámara a 2,20 metros de altura y posiciones diversas de los participantes, evidenciando un desempeño estable. [Figura Propia]}}{93}{figure.5.21}%
\contentsline {figure}{\numberline {5.22}{\ignorespaces Prueba final con variación del ángulo de la cámara, mostrando estabilidad en los niveles de similitud. [Figura Propia]}}{94}{figure.5.22}%
