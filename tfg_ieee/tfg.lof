\contentsline {figure}{\numberline {6.1}{\ignorespaces Encabezado del formulario de encuestas [Figura propia].}}{117}{figure.caption.102}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Resultados de la primera pregunta de la encuesta: “El sistema es fácil de usar y navegar” [Figura propia].}}{118}{figure.caption.103}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Resultados de la segunda pregunta de la encuesta: “Las funciones principales se entienden sin necesidad de asistencia o capacitación” [Figura propia].}}{118}{figure.caption.104}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Resultados de la tercera pregunta de la encuesta: “El tiempo de respuesta del sistema es adecuado durante su uso” [Figura propia].}}{119}{figure.caption.105}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Resultados de la cuarta pregunta de la encuesta: “Los mensajes o indicaciones del sistema son claros y comprensibles” [Figura propia].}}{119}{figure.caption.106}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Resultados de la quinta pregunta de la encuesta: “Puedo realizar las tareas necesarias (registro, asistencia, reportes) sin dificultad” [Figura propia].}}{120}{figure.caption.107}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Resultados de la sexta pregunta de la encuesta: “La interfaz del sistema tiene una apariencia ordenada y agradable” [Figura propia].}}{120}{figure.caption.108}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Resultados de la séptima pregunta de la encuesta: “Me siento seguro al utilizar el sistema para registrar información” [Figura propia].}}{121}{figure.caption.109}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Resultados de la octava pregunta de la encuesta: “Considero que el sistema mejora la rapidez y eficiencia del control de asistencia” [Figura propia].}}{121}{figure.caption.110}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces Resultados de la novena pregunta de la encuesta: “No experimenté errores o confusiones significativas al interactuar con las opciones del sistema” [Figura propia].}}{122}{figure.caption.111}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Resultados de la décima pregunta de la encuesta: “En general, estoy satisfecho con la experiencia de uso que ofrece el sistema” [Figura propia].}}{122}{figure.caption.112}%
