\contentsline {figure}{\numberline {6.1}{\ignorespaces Encabezado del formulario de encuestas Fuente: [Elaboración Propia].}}{127}{figure.caption.101}%
\contentsline {figure}{\numberline {6.2}{\ignorespaces Resultados de la primera pregunta de la encuesta: “El sistema es fácil de usar y navegar” Fuente: [Elaboración Propia].}}{128}{figure.caption.102}%
\contentsline {figure}{\numberline {6.3}{\ignorespaces Resultados de la segunda pregunta de la encuesta: “Las funciones principales se entienden sin necesidad de asistencia o capacitación” Fuente: [Elaboración Propia].}}{128}{figure.caption.103}%
\contentsline {figure}{\numberline {6.4}{\ignorespaces Resultados de la tercera pregunta de la encuesta: “El tiempo de respuesta del sistema es adecuado durante su uso” Fuente: [Elaboración Propia].}}{129}{figure.caption.104}%
\contentsline {figure}{\numberline {6.5}{\ignorespaces Resultados de la cuarta pregunta de la encuesta: “Los mensajes o indicaciones del sistema son claros y comprensibles” Fuente: [Elaboración Propia].}}{129}{figure.caption.105}%
\contentsline {figure}{\numberline {6.6}{\ignorespaces Resultados de la quinta pregunta de la encuesta: “Puedo realizar las tareas necesarias (registro, asistencia, reportes) sin dificultad” Fuente: [Elaboración Propia].}}{130}{figure.caption.106}%
\contentsline {figure}{\numberline {6.7}{\ignorespaces Resultados de la sexta pregunta de la encuesta: “La interfaz del sistema tiene una apariencia ordenada y agradable” Fuente: [Elaboración Propia].}}{130}{figure.caption.107}%
\contentsline {figure}{\numberline {6.8}{\ignorespaces Resultados de la séptima pregunta de la encuesta: “Me siento seguro al utilizar el sistema para registrar información” Fuente: [Elaboración Propia].}}{131}{figure.caption.108}%
\contentsline {figure}{\numberline {6.9}{\ignorespaces Resultados de la octava pregunta de la encuesta: “Considero que el sistema mejora la rapidez y eficiencia del control de asistencia” Fuente: [Elaboración Propia].}}{131}{figure.caption.109}%
\contentsline {figure}{\numberline {6.10}{\ignorespaces Resultados de la novena pregunta de la encuesta: “No experimenté errores o confusiones significativas al interactuar con las opciones del sistema” Fuente: [Elaboración Propia].}}{132}{figure.caption.110}%
\contentsline {figure}{\numberline {6.11}{\ignorespaces Resultados de la décima pregunta de la encuesta: “En general, estoy satisfecho con la experiencia de uso que ofrece el sistema” Fuente: [Elaboración Propia].}}{132}{figure.caption.111}%
\addvspace {10\p@ }
\contentsline {figure}{\numberline {6.12}{\ignorespaces Importaciones principales y definición de rutas base del módulo de entrenamiento \texttt {train\_faces}. Se cargan dependencias para detección y representación facial y se establecen las carpetas de trabajo del pipeline Fuente: [Elaboración Propia].}}{134}{figure.caption.114}%
\contentsline {figure}{\numberline {6.13}{\ignorespaces Función \texttt {recortar\_y\_guardar} del módulo \texttt {train\_faces}, detecta rostros con YOLOv8, recorta y guarda una versión normalizada (\(160\times 160\)) para generar embeddings Fuente: [Elaboración Propia].}}{135}{figure.caption.116}%
\contentsline {figure}{\numberline {6.14}{\ignorespaces Fragmento del código de la función \texttt {generar\_embeddings} del módulo \texttt {train\_faces}, donde se generan las representaciones vectoriales de los rostros utilizando el modelo \texttt {ArcFace} de DeepFace Fuente: [Elaboración Propia].}}{136}{figure.caption.118}%
\contentsline {figure}{\numberline {6.15}{\ignorespaces Fragmento del código que calcula el centroide facial y actualiza el índice global \texttt {centroids.json} con los nuevos embeddings generados Fuente: [Elaboración Propia].}}{137}{figure.caption.120}%
\contentsline {figure}{\numberline {6.16}{\ignorespaces Importaciones y configuración inicial del módulo \texttt {face\_recognizer}, donde se establecen las rutas a los embeddings y centroides utilizados en la fase de reconocimiento Fuente: [Elaboración Propia].}}{138}{figure.caption.122}%
\contentsline {figure}{\numberline {6.17}{\ignorespaces Función \texttt {load\_centroids} del módulo \texttt {face\_recognizer}, responsable de cargar y normalizar los centroides almacenados para su uso en el proceso de reconocimiento facial Fuente: [Elaboración Propia].}}{139}{figure.caption.124}%
\contentsline {figure}{\numberline {6.18}{\ignorespaces Función \texttt {recognize\_face} del módulo \texttt {face\_recognizer}, encargada de generar el embedding del rostro y compararlo con los centroides almacenados mediante la distancia coseno Fuente: [Elaboración Propia].}}{140}{figure.caption.126}%
\contentsline {figure}{\numberline {6.19}{\ignorespaces Función \texttt {recognize\_faces\_from\_crops} del módulo \texttt {face\_recognizer}, utilizada para procesar múltiples rostros detectados en una misma imagen y devolver sus resultados de identificación Fuente: [Elaboración Propia].}}{141}{figure.caption.128}%
